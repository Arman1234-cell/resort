{
  "name": "Green Coast Resort Automation",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "booking-success",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "1",
      "name": "Website Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [100, 300],
      "webhookId": "booking-success-hook"
    },
    {
      "parameters": {
        "dataType": "string",
        "value1": "={{ $json.body.event }}",
        "rules": {
          "rules": [
            {
              "value2": "new_booking"
            },
            {
              "value2": "daily_report",
              "output": 1
            }
          ]
        }
      },
      "id": "2",
      "name": "Route Event",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 1,
      "position": [300, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.brevo.com/v3/smtp/email",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "api-key",
              "value": "={{ $env.BREVO_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "sender",
              "value": "={{ { \"name\": \"Green Coast Resort\", \"email\": \"bookings@greencoastresort.in\" } }}"
            },
            {
              "name": "to",
              "value": "={{ [ { \"email\": $json.body.data.email, \"name\": $json.body.data.guestName } ] }}"
            },
            {
              "name": "subject",
              "value": "={{ 'Booking Confirmed - ' + $json.body.data.id }}"
            },
            {
              "name": "htmlContent",
              "value": "={{ '<h2>Booking Confirmed!</h2><p>Hi ' + $json.body.data.guestName + ', your booking is confirmed.</p>' }}"
            }
          ]
        },
        "options": {}
      },
      "id": "3",
      "name": "Email Guest (Brevo)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [550, 150]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://graph.facebook.com/v20.0/' + $env.WHATSAPP_PHONE_NUMBER_ID + '/messages' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.WHATSAPP_ACCESS_TOKEN }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "messaging_product",
              "value": "whatsapp"
            },
            {
              "name": "to",
              "value": "={{ $json.body.data.whatsapp.replace(/\\D/g, '') }}"
            },
            {
              "name": "type",
              "value": "text"
            },
            {
              "name": "text",
              "value": "={{ { \"body\": \"Hi \" + $json.body.data.guestName + \", your booking \" + $json.body.data.id + \" is confirmed!\" } }}"
            }
          ]
        },
        "options": {}
      },
      "id": "4",
      "name": "WhatsApp Guest",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [550, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://graph.facebook.com/v20.0/' + $env.WHATSAPP_PHONE_NUMBER_ID + '/messages' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.WHATSAPP_ACCESS_TOKEN }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "messaging_product",
              "value": "whatsapp"
            },
            {
              "name": "to",
              "value": "={{ $env.RESORT_WHATSAPP }}"
            },
            {
              "name": "type",
              "value": "text"
            },
            {
              "name": "text",
              "value": "={{ { \"body\": \"New Paid Booking! Ref: \" + $json.body.data.id + \" by \" + $json.body.data.guestName } }}"
            }
          ]
        },
        "options": {}
      },
      "id": "5",
      "name": "WhatsApp Owner",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [550, 450]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * *"
            }
          ]
        }
      },
      "id": "6",
      "name": "Daily Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [100, 650]
    },
    {
      "parameters": {
        "url": "https://halc.site/api/daily-report",
        "options": {}
      },
      "id": "7",
      "name": "Fetch Daily Report",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [300, 650]
    }
  ],
  "connections": {
    "Website Webhook": {
      "main": [
        [
          {
            "node": "Route Event",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Route Event": {
      "main": [
        [
          {
            "node": "Email Guest (Brevo)",
            "type": "main",
            "index": 0
          },
          {
            "node": "WhatsApp Guest",
            "type": "main",
            "index": 0
          },
          {
            "node": "WhatsApp Owner",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Daily Schedule": {
      "main": [
        [
          {
            "node": "Fetch Daily Report",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
